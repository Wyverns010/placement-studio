OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-5.4-mini
OPENAI_MODEL_CREATIVE=gpt-5.5
GATE_IMPL=llm
# Suggested dev value: .cache/llm
LLM_CACHE_DIR=
# low | medium | high | default (omit the parameter)
OPENAI_REASONING_EFFORT=low
# 1 = send OpenAI Agents SDK traces to OpenAI (step agents); unset/0 = tracing off
OPENAI_AGENTS_TRACING=
